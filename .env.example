# Copy to .env (next to docker-compose.yml) and adjust. Every value has a working default.

# Local LLM used to read company descriptions (any Ollama model with structured outputs).
# qwen3:1.7b (Apache-2.0, ~1.4 GB) runs fully on a 4 GB GPU such as a GTX 1050 Ti (~10-15 s per extraction).
# qwen3:4b extracts better but needs ~6 GB of VRAM; on 4 GB it spills into system RAM and becomes very slow.
# Use LLM_PROVIDER=heuristic to disable the LLM.
OLLAMA_MODEL=qwen3:1.7b
LLM_PROVIDER=ollama

# "sentence-transformers" (multilingual MiniLM, downloaded once) or "hashing" (no download, lower quality)
EMBEDDINGS_BACKEND=sentence-transformers

# Optional knowledge graph: start with `docker compose --profile graph up` AND uncomment the next line
# NEO4J_URI=bolt://neo4j:7687
NEO4J_PASSWORD=gobiz-graph

MYSQL_PASSWORD=gobiz
MYSQL_ROOT_PASSWORD=gobiz-root
